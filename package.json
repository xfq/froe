{
  "name": "@xfq/froe",
  "version": "0.2.1",
  "description": "An inspectable coding agent for work in a codebase.",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "froe": "dist/cli.js"
  },
  "exports": {
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "froe.config.schema.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node scripts/clean-dist.mjs && pnpm build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/**/*.test.ts",
    "dev": "tsx src/cli.ts",
    "eval": "tsx scripts/eval.ts",
    "smoke:openai": "tsx scripts/smoke-openai.ts"
  },
  "dependencies": {
    "openai": "^7.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
