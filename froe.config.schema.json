{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "froe configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "provider": { "const": "openai" },
    "baseURL": { "type": "string", "format": "uri" },
    "autoUpdate": {
      "type": "boolean",
      "description": "Automatically check for and install newer stable npm releases."
    },
    "model": { "type": "string" },
    "reasoning": {
      "enum": ["none", "low", "medium", "high", "xhigh", "max"]
    },
    "imageGeneration": {
      "type": "object",
      "additionalProperties": false,
      "description": "Settings for OpenAI Responses API image generation. It is enabled by default and cannot be changed by workspace configuration. Froe disables it for a model after the API reports that the image-generation tool is unsupported.",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "model": { "type": "string", "minLength": 1 },
        "size": { "type": "string", "pattern": "^(auto|[1-9][0-9]{1,3}x[1-9][0-9]{1,3})$" },
        "quality": { "enum": ["auto", "low", "medium", "high"] },
        "background": { "enum": ["auto", "opaque", "transparent"] },
        "outputFormat": { "enum": ["jpeg", "png", "webp"] }
      }
    },
    "compactThresholdTokens": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Token threshold for OpenAI server-side context compaction, or null to disable it."
    },
    "maxTurns": { "type": "integer", "minimum": 1 },
    "logging": { "enum": ["metadata", "full"] },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readLines": { "type": "integer", "minimum": 1 },
        "readBytes": { "type": "integer", "minimum": 1 },
        "searchResults": { "type": "integer", "minimum": 1 },
        "commandOutputBytes": { "type": "integer", "minimum": 1 },
        "commandTimeoutMs": { "type": "integer", "minimum": 1 }
      }
    },
    "commandEnv": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "extraInstructions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Standing instructions appended to every run's system prompt. Allowed only in user configuration; project-owned guidance belongs in AGENTS.md or CLAUDE.md."
    },
    "mcpServers": {
      "type": "object",
      "description": "User-controlled stdio or remote Streamable HTTP MCP servers.",
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$" },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["command"],
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "args": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
            }
          }
        ]
      }
    }
  }
}
